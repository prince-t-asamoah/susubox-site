---
import { findPhoto, photoSources, type PhotoOptions } from "../lib/photos";

interface Props extends PhotoOptions {
  /** File name in src/assets/ without extension. */
  name: string;
  alt: string;
  sizes: string;
  /** LCP image: eager + fetchpriority=high. Everything else is lazy. */
  priority?: boolean;
  class?: string;
}

const { name, alt, sizes, priority = false, ratio, position, class: className } = Astro.props;
const photo = findPhoto(name);
const sources = photo ? await photoSources(photo, { ratio, position }) : null;
const [rw, rh] = ratio;
---
{sources ? (
  <picture class:list={["photo", className]} style={`aspect-ratio: ${rw} / ${rh}`}>
    <source type="image/avif" srcset={sources.avif.srcSet.attribute} sizes={sizes} />
    <source type="image/webp" srcset={sources.webp.srcSet.attribute} sizes={sizes} />
    <img
      src={sources.jpg.src}
      width={sources.jpg.attributes.width}
      height={sources.jpg.attributes.height}
      alt={alt}
      decoding={priority ? "sync" : "async"}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      data-image-component={import.meta.env.DEV ? "true" : undefined}
    />
  </picture>
) : (
  <Fragment>
    <Fragment set:html={`<!-- TODO: photo "${name}" (${rw}:${rh}). Add src/assets/${name}.jpg from Unsplash/Pexels and credit it in the README. -->`} />
    <div class:list={["photo", "photo--placeholder", className]} style={`aspect-ratio: ${rw} / ${rh}`} aria-hidden="true">
      <svg viewBox="0 0 120 120" width="120" height="120" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <rect x="38" y="16" width="44" height="88" rx="8" fill="#fff" stroke="#0B6E4F" />
        <path d="M54 26h12" stroke="#0B6E4F" />
        <rect x="46" y="38" width="28" height="12" rx="4" fill="#E3F0EA" stroke="#0B6E4F" />
        <rect x="46" y="58" width="22" height="12" rx="4" fill="#F2A900" stroke="#0B6E4F" />
        <path d="m50 84 5 5 10-10" stroke="#0B6E4F" />
      </svg>
    </div>
  </Fragment>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo--placeholder {
    display: grid;
    place-items: center;
    background: var(--color-success-tint);
  }
</style>
