---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
// TODO: this page's title and description are not in SPEC.md; confirm the copy.
---
<Base
  title="Thank you — SusuBox"
  description="Thanks for contacting SusuBox. We'll be in touch within one working day."
  noindex
>
  <div class="container thanks">
    <span class="thanks__icon"><Icon name="check" size={32} /></span>
    {/* SAMPLE: response time, confirm with owner */}
    <h1>Thank you — we'll be in touch within one working day.</h1>
    <Button href="/" block>Back to home</Button>
  </div>
</Base>

<style>
  .thanks {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }

  .thanks__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-success-tint);
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .thanks {
      max-width: calc(48rem + 2 * var(--gutter));
      padding-block: var(--space-8) var(--space-12);
    }
  }
</style>
