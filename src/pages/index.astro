---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Photo from "../components/Photo.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import StepCard from "../components/StepCard.astro";
import { findPhoto, photoSources } from "../lib/photos";
import { stats, testimonial } from "../config";

const hero = { name: "hero-trader", ratio: [4, 5] as [number, number] };
const heroSizes = "(min-width: 1216px) 497px, (min-width: 768px) 40vw, calc(100vw - 32px)";
const heroPhoto = findPhoto(hero.name);
const heroPreload = heroPhoto
  ? { srcset: (await photoSources(heroPhoto, hero)).avif.srcSet.attribute, sizes: heroSizes }
  : undefined;

const problems: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "card-lost",
    title: "Paper cards get lost",
    text: "A torn or missing susu card can mean weeks of savings with no proof.",
  },
  { icon: "bank", title: "Banks ask for history", text: "Lenders want records. Most traders have none on paper." },
  { icon: "clock", title: "No time to visit a bank", text: "Your stall can't close for half a day to queue." },
];
---
<Base
  title="SusuBox — Daily susu savings on WhatsApp"
  description="Save daily with your susu collector and get a clear record on WhatsApp. Built for market traders in Ghana."
  preloadImage={heroPreload}
>
  <!-- 6.1 Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">For market traders in Ghana</p>
        <h1 id="hero-title">Your daily susu, recorded on WhatsApp</h1>
        <p class="lead">
          Send your contribution by WhatsApp. SusuBox keeps the record, sends you a weekly statement, and helps you
          show lenders how well you save.
        </p>
        <div class="hero__actions">
          <Button whatsapp block>Start saving on WhatsApp</Button>
          <Button href="#how-it-works" variant="secondary" block>How it works</Button>
        </div>
        <p class="small muted">No app to download · Works on any phone with WhatsApp</p>
      </div>
      <Photo
        class="hero__photo"
        name={hero.name}
        ratio={hero.ratio}
        sizes={heroSizes}
        alt="A market trader checks her savings record on her phone"
        priority
      />
    </div>
  </section>

  <!-- 6.2 Problem strip -->
  <section class="section section--surface" aria-labelledby="problem-title">
    <div class="container stack">
      <h2 id="problem-title" class="problem__title">Saving every day, but no record to show for it</h2>
      <ul class="problem__list" role="list">
        {problems.map((item) => (
          <li class="problem__item">
            <span class="icon-tile"><Icon name={item.icon} /></span>
            <div class="problem__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6.3 How it works -->
  <section id="how-it-works" class="section" aria-labelledby="steps-title">
    <div class="container stack">
      <h2 id="steps-title">How SusuBox works</h2>
      <ol class="steps" role="list">
        <StepCard number={1} title="Message us on WhatsApp">
          {/* SAMPLE: registration time, confirm with owner */}
          Say hello and we register you in under five minutes. Just your name, market and phone number.
        </StepCard>
        <StepCard number={2} title="Send your daily amount">
          Each day, type what you paid your collector. For example: "Paid 20 cedis".
        </StepCard>
        <StepCard number={3} title="Get your weekly statement">
          {/* SAMPLE: statement day, confirm with owner */}
          Every Sunday we send a clear summary of what you saved. Download it any time.
        </StepCard>
      </ol>
      <div class="steps__cta">
        <Button whatsapp block>Start saving on WhatsApp</Button>
      </div>
    </div>
  </section>

  <!-- 6.4 Benefits -->
  <section class="section section--rule" aria-labelledby="benefits-title">
    <div class="container benefits">
      <div class="benefits__text">
        <h2 id="benefits-title">Built for how you already work</h2>
        <ul class="checklist" role="list">
          <li><Icon name="check" />Works with your existing susu collector</li>
          <li><Icon name="check" />Records in English or Twi</li>
          <li><Icon name="check" />Weekly statements you can share with a lender</li>
          <li><Icon name="check" />Your data stays private — only you see your record</li>
        </ul>
      </div>
      <Photo
        class="benefits__photo"
        name="benefits-collector"
        ratio={[1, 1]}
        sizes="(min-width: 1216px) 544px, (min-width: 768px) 45vw, calc(100vw - 32px)"
        alt="A susu collector visits a trader at her stall"
      />
    </div>
  </section>

  <!-- 6.5 Numbers strip (SAMPLE values in src/config.ts) -->
  <div class="numbers">
    <ul class="container numbers__list" role="list">
      {stats.map((stat) => (
        <li class="stat">
          <strong class="stat__value">{stat.value}</strong>
          <span>{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- 6.6 Testimonial (SAMPLE in src/config.ts; set it to null to remove the section) -->
  {testimonial && (
    <div class="testimonial">
      <figure class="container testimonial__inner">
        <blockquote>
          <p>"{testimonial.quote}"</p>
        </blockquote>
        <figcaption class="small muted">— {testimonial.attribution}</figcaption>
      </figure>
    </div>
  )}
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: 24px 48px;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Gold pill with ink text: gold text on white fails AA (design handoff, difference 1). */
  .eyebrow {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .hero :global(.hero__photo) {
    margin-top: var(--space-1);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero__grid {
      grid-template-columns: 55fr 45fr;
      align-items: center;
      gap: var(--space-8);
    }

    .hero__text {
      gap: var(--space-3);
    }

    .hero .lead {
      max-width: 34em;
    }

    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      margin-top: 0;
    }

    .hero :global(.hero__photo) {
      margin-top: 0;
    }
  }

  /* ---------- Problem strip ---------- */
  .problem__list {
    display: grid;
    gap: var(--space-3);
  }

  .problem__item {
    display: flex;
    gap: var(--space-2);
  }

  .problem__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .icon-tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .problem__title {
      max-width: 20em;
    }

    .problem__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .problem__item {
      flex-direction: column;
    }
  }

  /* ---------- How it works ---------- */
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  /* Gold connector behind the cards, visible only in the gaps (decorative). */
  .steps::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 47px;
    width: 2px;
    background: var(--color-accent);
  }

  .steps__cta {
    display: flex;
  }

  .steps__cta :global(.btn) {
    flex: 1;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .steps::before {
      top: 47px;
      bottom: auto;
      left: 48px;
      right: 48px;
      width: auto;
      height: 2px;
    }

    .steps__cta {
      justify-content: center;
    }

    .steps__cta :global(.btn) {
      flex: none;
    }
  }

  /* ---------- Benefits ---------- */
  .benefits {
    display: grid;
    gap: var(--stack);
  }

  .benefits__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .checklist {
    display: grid;
    gap: var(--space-2);
  }

  .checklist li {
    display: flex;
    gap: 12px;
  }

  .checklist svg {
    flex: none;
    margin-top: 1px;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .benefits {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }

    /* Image left, list right (SPEC §6.4); the list stays first in source for mobile. */
    .benefits :global(.benefits__photo) {
      grid-row: 1;
      grid-column: 1;
    }

    .checklist li {
      font-size: 1.125rem;
    }

    .checklist svg {
      margin-top: 3px;
    }
  }

  /* ---------- Numbers strip ---------- */
  .numbers {
    padding-block: var(--section-y);
    background: var(--color-primary);
    color: #fff;
  }

  .numbers__list {
    display: grid;
    gap: var(--space-3);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat + .stat {
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .stat__value {
    font-size: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  @media (min-width: 768px) {
    .numbers__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .stat + .stat {
      padding-top: 0;
      padding-left: var(--space-4);
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.3);
    }

    .stat__value {
      font-size: 3rem;
    }
  }

  /* ---------- Testimonial ---------- */
  .testimonial {
    padding-block: var(--space-8);
  }

  .testimonial__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .testimonial blockquote {
    font-size: 1.25rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .testimonial {
      padding-block: var(--space-12);
    }

    .testimonial__inner {
      max-width: calc(800px + 2 * var(--gutter));
      text-align: center;
    }

    .testimonial blockquote {
      font-size: 1.75rem;
      line-height: 1.45;
    }

    .testimonial figcaption {
      font-size: 1rem;
    }
  }
</style>
